%global debug_package %{nil}
%global _build_id_links none
%global _missing_build_ids_terminate_build 0
%global vinput_source_sha256 @VINPUT_SOURCE_SHA256@
%global vinput_rust_target @VINPUT_RUST_TARGET@
%global vinput_sherpa_archive_root @VINPUT_SHERPA_ONNX_ARCHIVE_ROOT@
%global vinput_cargo_home %{?_vinput_cargo_home}%{!?_vinput_cargo_home:%{_topdir}/cargo-home}
%global vinput_cargo_target %{?_vinput_cargo_target}%{!?_vinput_cargo_target:%{_topdir}/cargo-target}
%global vinput_cmake_build %{?_vinput_cmake_build}%{!?_vinput_cmake_build:%{_topdir}/cmake-build}

Name:           fcitx-vinput-rs
Version:        @VINPUT_VERSION@
Release:        @VINPUT_RELEASE@%{?dist}
Summary:        Rust voice-input addon and daemon for Fcitx 5
License:        GPL-3.0-or-later AND Apache-2.0 AND MIT
URL:            https://github.com/rijuyuezhu/fcitx-vinput-rs
Source0:        @VINPUT_SOURCE_NAME@
Source1:        @VINPUT_SHERPA_ONNX_ARCHIVE@
Source2:        sherpa-onnx-LICENSE-@VINPUT_SHERPA_ONNX_VERSION@
Source3:        onnxruntime-LICENSE-@VINPUT_ONNXRUNTIME_VERSION@

ExclusiveArch:  @VINPUT_PACKAGE_ARCH@
Provides:       fcitx5-vinput = %{version}-%{release}
Conflicts:      fcitx5-vinput
Requires:       coreutils
Requires:       fcitx5
Requires:       fontconfig
Requires:       glib2
Requires:       libX11
Requires:       libxkbcommon
Requires:       pipewire-libs
Requires:       systemd
Requires:       util-linux
Requires:       wayland

BuildRequires:  cargo
BuildRequires:  clang
BuildRequires:  cmake
BuildRequires:  gettext
BuildRequires:  ninja-build
BuildRequires:  patchelf
BuildRequires:  pkgconfig(fcitx5)
BuildRequires:  pkgconfig(libsystemd)
BuildRequires:  pkgconfig(libpipewire-0.3)

%description
A Rust rewrite of fcitx5-vinput. The package contains the command-line
management tool, D-Bus daemon, Rust/Iced management GUI, thin Fcitx 5 addon,
activation metadata, translations, and checksum-pinned private native ASR
runtime libraries.

%prep
printf '%s  %s\n' '%{vinput_source_sha256}' '%{SOURCE0}' | sha256sum -c -
printf '%s  %s\n' '@VINPUT_SHERPA_ONNX_SHA256@' '%{SOURCE1}' | sha256sum -c -
printf '%s  %s\n' '@VINPUT_SHERPA_ONNX_LICENSE_SHA256@' '%{SOURCE2}' | sha256sum -c -
printf '%s  %s\n' '@VINPUT_ONNXRUNTIME_LICENSE_SHA256@' '%{SOURCE3}' | sha256sum -c -
%setup -q -n @VINPUT_SOURCE_DIR@
tar -xjf "%{SOURCE1}" -C "%{_builddir}"

%build
export CARGO_HOME="%{vinput_cargo_home}"
export CARGO_TARGET_DIR="%{vinput_cargo_target}"
export SHERPA_ONNX_LIB_DIR="%{_builddir}/%{vinput_sherpa_archive_root}/lib"
export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=%{_builddir}=."
export CFLAGS="${CFLAGS:-} -ffile-prefix-map=%{_builddir}=. -fdebug-prefix-map=%{_builddir}=."
export CXXFLAGS="${CXXFLAGS:-} -ffile-prefix-map=%{_builddir}=. -fdebug-prefix-map=%{_builddir}=."

cargo fetch --locked --target %{vinput_rust_target}
export CARGO_NET_OFFLINE=true
cargo build --frozen --release \
  -p vinput-cli --features pipewire-backend,sherpa-onnx-backend \
  -p vinput-daemon --features pipewire-backend,sherpa-onnx-backend \
  -p vinput-gui

cmake -S cpp/fcitx5-addon -B "%{vinput_cmake_build}" -G Ninja \
  -DBUILD_TESTING=OFF \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_INSTALL_PREFIX=%{_prefix} \
  -DCMAKE_INSTALL_LIBDIR=lib64 \
  -DVINPUT_DAEMON_EXECUTABLE=%{_bindir}/vinput-daemon \
  -DVINPUT_DAEMON_ARGS='--dbus --configured-backends --audio-backend pipewire' \
  -DVINPUT_FCITX_BRIDGE_ENABLE_TESTS=OFF \
  -DVINPUT_FCITX_BRIDGE_REQUIRE_FCITX_CORE=ON \
  -DVINPUT_FCITX_MODULE_INSTALL_DIR=lib64/fcitx5 \
  -DVINPUT_FCITX_RUNTIME_BUILD_LOCALEDIR='' \
  -DVINPUT_SYSTEMD_USER_UNIT_DIR=lib/systemd/user
cmake --build "%{vinput_cmake_build}" \
  --target fcitx5_vinput_addon --parallel %{_smp_build_ncpus}

%install
rm -rf "%{buildroot}"
install -Dm755 "%{vinput_cargo_target}/release/vinput" \
  "%{buildroot}%{_bindir}/vinput"
install -Dm755 "%{vinput_cargo_target}/release/vinput-daemon" \
  "%{buildroot}%{_bindir}/vinput-daemon"
install -Dm755 "%{vinput_cargo_target}/release/vinput-gui" \
  "%{buildroot}%{_bindir}/vinput-gui"

install -Dm644 scripts/release/package-session-common.sh \
  "%{buildroot}/usr/lib/fcitx-vinput/package-session-common.sh"
install -Dm755 scripts/release/package-upgrade-handoff.sh \
  "%{buildroot}/usr/lib/fcitx-vinput/package-upgrade-handoff"
install -Dm755 scripts/release/package-remove-handoff.sh \
  "%{buildroot}/usr/lib/fcitx-vinput/package-remove-handoff"

install -Dm755 "%{_builddir}/%{vinput_sherpa_archive_root}/lib/libsherpa-onnx-c-api.so" \
  "%{buildroot}/usr/lib/fcitx-vinput/libsherpa-onnx-c-api.so"
install -Dm755 "%{_builddir}/%{vinput_sherpa_archive_root}/lib/libonnxruntime.so" \
  "%{buildroot}/usr/lib/fcitx-vinput/libonnxruntime.so"
patchelf --set-rpath '$ORIGIN/../lib/fcitx-vinput' "%{buildroot}%{_bindir}/vinput"
patchelf --set-rpath '$ORIGIN/../lib/fcitx-vinput' "%{buildroot}%{_bindir}/vinput-daemon"
patchelf --set-rpath '$ORIGIN' \
  "%{buildroot}/usr/lib/fcitx-vinput/libsherpa-onnx-c-api.so"

DESTDIR="%{buildroot}" cmake --install "%{vinput_cmake_build}"
install -Dm644 data/vinput-gui.desktop \
  "%{buildroot}%{_datadir}/applications/vinput-gui.desktop"
for size in 16 22 24 32 48 64 128 256 512; do
  install -Dm644 "data/icons/hicolor/${size}x${size}/apps/vinput-gui.png" \
    "%{buildroot}%{_datadir}/icons/hicolor/${size}x${size}/apps/vinput-gui.png"
done
install -Dm644 data/default-config.json \
  "%{buildroot}%{_datadir}/fcitx-vinput/default-config.json"
install -Dm644 data/vad/silero_vad.onnx \
  "%{buildroot}%{_datadir}/fcitx-vinput/vad/silero_vad.onnx"
install -Dm644 data/vad/LICENSE \
  "%{buildroot}%{_licensedir}/%{name}/silero-vad-LICENSE"
install -Dm644 "%{SOURCE2}" \
  "%{buildroot}%{_licensedir}/%{name}/sherpa-onnx-LICENSE"
install -Dm644 "%{SOURCE3}" \
  "%{buildroot}%{_licensedir}/%{name}/onnxruntime-LICENSE"

%post -p /bin/bash
if [[ "$1" -gt 1 && -x /usr/lib/fcitx-vinput/package-upgrade-handoff ]]; then
  /usr/lib/fcitx-vinput/package-upgrade-handoff
fi
printf '%s\n' 'Restart or reload Fcitx5 in each active desktop session to load the vinput addon.'

%preun -p /bin/bash
if [[ "$1" -eq 0 && -x /usr/lib/fcitx-vinput/package-remove-handoff ]]; then
  /usr/lib/fcitx-vinput/package-remove-handoff
fi

%postun -p /bin/bash
if [[ "$1" -eq 0 ]]; then
  printf '%s\n' 'User configuration, models, and cache were preserved; reload Fcitx5.'
fi

%files
%license %{_licensedir}/%{name}/
%{_bindir}/vinput
%{_bindir}/vinput-daemon
%{_bindir}/vinput-gui
/usr/lib/fcitx-vinput/
%{_libdir}/fcitx5/fcitx5-vinput.so
%{_prefix}/lib/systemd/user/vinput-daemon.service
%{_datadir}/applications/vinput-gui.desktop
%{_datadir}/dbus-1/services/org.fcitx.Vinput.service
%{_datadir}/fcitx-vinput/
%{_datadir}/fcitx5/addon/vinput.conf
%{_datadir}/icons/hicolor/*/apps/vinput-gui.png
%lang(zh_CN) %{_datadir}/locale/zh_CN/LC_MESSAGES/fcitx5-vinput.mo

%changelog
* Sun Aug 02 2026 Vinput Maintainers <maintainers@example.invalid> - @VINPUT_VERSION@-@VINPUT_RELEASE@
- Add the checked RPM packaging baseline.
