# shellcheck shell=bash

post_install() {
  printf '%s\n' \
    ':: fcitx-vinput-rs installed.' \
    ':: For each desktop user, start the daemon with:' \
    '   systemctl --user enable --now vinput-daemon.service' \
    ':: Reload Fcitx5 so the new addon is discovered:' \
    '   fcitx5 -r'
}

post_upgrade() {
  printf '%s\n' \
    ':: fcitx-vinput-rs upgraded.' \
    ':: Daemons started by current activation metadata hand off automatically.' \
    ':: If an older owner remains, each affected desktop user can run:' \
    '   vinput daemon handoff' \
    ':: The guarded handoff reloads systemd metadata or replaces an idle direct owner.' \
    ':: Reload Fcitx5 if the addon binary changed:' \
    '   fcitx5 -r'
}

pre_remove() {
  local helper="${VINPUT_PACKAGE_REMOVE_HANDOFF:-/usr/lib/fcitx-vinput/package-remove-handoff}"
  if [[ -x "${helper}" ]]; then
    "${helper}"
  fi
}

post_remove() {
  printf '%s\n' \
    ':: fcitx-vinput-rs removed.' \
    ':: Active daemon owners were stopped by the guarded pre-remove handoff.' \
    ':: User config, models, and cache were intentionally preserved.' \
    ':: Reload Fcitx5 to unload the removed addon:' \
    '   fcitx5 -r'
}
