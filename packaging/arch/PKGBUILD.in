pkgname=fcitx-vinput-rs
pkgver=@VINPUT_PKGVER@
pkgrel=@VINPUT_PKGREL@
pkgdesc='Rust rewrite of fcitx5-vinput with native ASR and PipeWire capture'
arch=('x86_64')
url='https://github.com/rijuyuezhu/fcitx-vinput-rs'
license=('GPL-3.0-or-later' 'Apache-2.0' 'MIT')
depends=(
  'fcitx5'
  'glibc'
  'libgcc'
  'libpipewire'
  'libstdc++'
  'systemd-libs'
)
makedepends=(
  'cargo'
  'clang'
  'cmake'
  'gettext'
  'ninja'
  'patchelf'
  'pkgconf'
)
optdepends=('wireplumber: output-volume ducking through wpctl')
provides=("fcitx5-vinput=${pkgver}")
conflicts=('fcitx5-vinput')
options=('!debug' '!lto')
install=fcitx-vinput-rs.install

_source_dir='@VINPUT_SOURCE_DIR@'
_sherpa_onnx_ver='1.13.3'
_onnxruntime_ver='1.24.4'
source=(
  "${pkgname}-${pkgver}.tar.gz::@VINPUT_SOURCE_URL@"
  "sherpa-onnx-v${_sherpa_onnx_ver}-linux-x64-shared-lib.tar.bz2::https://github.com/k2-fsa/sherpa-onnx/releases/download/v${_sherpa_onnx_ver}/sherpa-onnx-v${_sherpa_onnx_ver}-linux-x64-shared-lib.tar.bz2"
  "sherpa-onnx-LICENSE-${_sherpa_onnx_ver}::https://raw.githubusercontent.com/k2-fsa/sherpa-onnx/v${_sherpa_onnx_ver}/LICENSE"
  "onnxruntime-LICENSE-${_onnxruntime_ver}::https://raw.githubusercontent.com/microsoft/onnxruntime/v${_onnxruntime_ver}/LICENSE"
)
sha256sums=(
  '@VINPUT_SOURCE_SHA256@'
  '650d3da32694fa48e6e018f7087e4840aace56b3187a294a18ba3b9f51e80943'
  'cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30'
  '2f07c72751aed99790b8a4869cf2311df85a860b22ded05fa22803587a48922c'
)

prepare() {
  cd "${_source_dir}"
  export CARGO_HOME="${srcdir}/cargo-home"
  cargo fetch --locked --target x86_64-unknown-linux-gnu
}

build() {
  cd "${_source_dir}"
  export CARGO_HOME="${srcdir}/cargo-home"
  export CARGO_TARGET_DIR="${srcdir}/cargo-target"
  export CARGO_NET_OFFLINE=true
  export SHERPA_ONNX_LIB_DIR="${srcdir}/sherpa-onnx-v${_sherpa_onnx_ver}-linux-x64-shared-lib/lib"
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=."
  export CFLAGS="${CFLAGS} -ffile-prefix-map=${srcdir}=. -fdebug-prefix-map=${srcdir}=."
  export CXXFLAGS="${CXXFLAGS} -ffile-prefix-map=${srcdir}=. -fdebug-prefix-map=${srcdir}=."

  cargo build --frozen --release \
    -p vinput-cli --features pipewire-backend,sherpa-onnx-backend \
    -p vinput-daemon --features pipewire-backend,sherpa-onnx-backend

  cmake -S cpp/fcitx5-addon -B "${srcdir}/cmake-build" -G Ninja \
    -DBUILD_TESTING=OFF \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DVINPUT_DAEMON_EXECUTABLE=/usr/bin/vinput-daemon \
    -DVINPUT_DAEMON_ARGS='--dbus --configured-backends --audio-backend pipewire' \
    -DVINPUT_FCITX_BRIDGE_ENABLE_TESTS=OFF \
    -DVINPUT_FCITX_BRIDGE_REQUIRE_FCITX_CORE=ON \
    -DVINPUT_FCITX_RUNTIME_BUILD_LOCALEDIR=''
  cmake --build "${srcdir}/cmake-build"
}

package() {
  cd "${_source_dir}"

  install -Dm755 "${srcdir}/cargo-target/release/vinput" "${pkgdir}/usr/bin/vinput"
  install -Dm755 "${srcdir}/cargo-target/release/vinput-daemon" \
    "${pkgdir}/usr/bin/vinput-daemon"

  install -Dm755 \
    "${srcdir}/sherpa-onnx-v${_sherpa_onnx_ver}-linux-x64-shared-lib/lib/libsherpa-onnx-c-api.so" \
    "${pkgdir}/usr/lib/fcitx-vinput/libsherpa-onnx-c-api.so"
  install -Dm755 \
    "${srcdir}/sherpa-onnx-v${_sherpa_onnx_ver}-linux-x64-shared-lib/lib/libonnxruntime.so" \
    "${pkgdir}/usr/lib/fcitx-vinput/libonnxruntime.so"
  patchelf --set-rpath '$ORIGIN/../lib/fcitx-vinput' "${pkgdir}/usr/bin/vinput"
  patchelf --set-rpath '$ORIGIN/../lib/fcitx-vinput' "${pkgdir}/usr/bin/vinput-daemon"
  patchelf --set-rpath '$ORIGIN' \
    "${pkgdir}/usr/lib/fcitx-vinput/libsherpa-onnx-c-api.so"

  DESTDIR="${pkgdir}" cmake --install "${srcdir}/cmake-build"

  install -Dm644 data/default-config.json \
    "${pkgdir}/usr/share/fcitx-vinput/default-config.json"
  install -Dm644 data/vad/silero_vad.onnx \
    "${pkgdir}/usr/share/fcitx-vinput/vad/silero_vad.onnx"
  install -Dm644 data/vad/LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/silero-vad-LICENSE"
  install -Dm644 "${srcdir}/sherpa-onnx-LICENSE-${_sherpa_onnx_ver}" \
    "${pkgdir}/usr/share/licenses/${pkgname}/sherpa-onnx-LICENSE"
  install -Dm644 "${srcdir}/onnxruntime-LICENSE-${_onnxruntime_ver}" \
    "${pkgdir}/usr/share/licenses/${pkgname}/onnxruntime-LICENSE"
}
