      "id": "ASR-CONTRACT-001",
      "state": "audited-with-gap",
      "title": "Recognition session event contract, payload conversion, and minimum recording gate",
      "upstream_files": [
        "daemon/asr/runtime/recognition_contract.h"
      ],
      "current_files": [
        "crates/vinpst-asr/src/payload.rs",
